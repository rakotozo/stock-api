

# Création d'un catégorie

POST : http://localhost:8000/api/categories

`
    Header:
            Content-Type: application/ld+json
            Accept: application/ld+json
`

`
   ld (L minuscule + d minuscule)
`

{
  "name":"Accessoire",
  "description":"Accessoire sur les motos"
}

`
    {
        "@context": "/api/contexts/Category",
        "@id": "/api/categories/2",
        "@type": "Category",
        "id": 2,
        "name": "test",
        "description": "desc",
        "createdAt": "2026-11-06T07:16:50+01:00"
    }

`

# Création d'un produit

POST : http://localhost:8000/api/products


`
    Header:
            Content-Type: application/ld+json
            Accept: application/ld+json
`

`
    {
    "name": "Produit 1",
    "reference": "12054",
    "description": "description",
    "purchasePrice": "200",
    "sellingPrice": "200",
    "minStock": 1,
    "category": "/api/categories/2"
    }
`
`
    {
    "@context": "/api/contexts/Product",
    "@id": "/api/products/1",
    "@type": "Product",
    "id": 1,
    "name": "Produit 1",
    "reference": "12054",
    "description": "description",
    "purchasePrice": "200.00",
    "sellingPrice": "200.00",
    "minStock": 1,
    "createdAt": "2026-11-06T07:31:06+01:00",
    "category": "/api/categories/2"
    }

`

# Création d'un founisseur

POST : http://localhost:8000/api/suppliers


`
    Header:
            Content-Type: application/ld+json
            Accept: application/ld+json
`

`
    {
    "name": "Rong Xing",
    "email": "rong-xing@gmail.com",
    "phone": "03450588 43",
    "address": "test"
    }
`
`
{
  "@context": "/api/contexts/Supplier",
  "@id": "/api/suppliers/1",
  "@type": "Supplier",
  "id": 1,
  "name": "Rong Xing",
  "email": "rong-xing@gmail.com",
  "phone": "03450588 43",
  "address": "test",
  "createdAt": "2026-11-06T07:35:39+01:00"
}

`
